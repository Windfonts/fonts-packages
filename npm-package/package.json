{
  "name": "@windfonts/chinese-fonts",
  "version": "1.0.8",
  "description": "Chinese web fonts with CDN links and comprehensive license information",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./fonts/*": {
      "import": "./fonts/*.js",
      "require": "./fonts/*.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prepack": "node scripts/minify-fonts-json.js"
  },
  "files": [
    "src/index.js",
    "src/index.mjs",
    "src/index.d.ts",
    "src/font-data",
    "src/font-list.json",
    "fonts"
  ],
  "keywords": [
    "fonts",
    "chinese",
    "cjk",
    "webfonts",
    "cdn",
    "typography",
    "license",
    "windfonts",
    "中文字体",
    "web-fonts",
    "font-loader",
    "alibaba-puhuiti",
    "chinese-typography"
  ],
  "author": "WindFonts",
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Windfonts/font-packages.git"
  },
  "bugs": {
    "url": "https://github.com/Windfonts/font-packages/issues"
  },
  "homepage": "https://github.com/Windfonts/font-packages#readme"
}
